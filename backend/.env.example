# Port the API server listens on. Most hosts (Render, Fly, Railway) inject this
# for you — leave it unset there and the server falls back to 3000 locally.
PORT=3000

# Comma-separated list of origins allowed to call the API (your frontend URL(s)).
# Use "*" only for local development.
# No trailing slashes — these are matched against the browser's Origin header,
# which never has one.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://iconvex.vercel.app

# Max upload size in megabytes
MAX_UPLOAD_MB=200

# How long (in minutes) a finished job's files are kept before being deleted
JOB_TTL_MINUTES=60

# How many conversions can run at the same time
MAX_CONCURRENT_CONVERSIONS=2

# Where uploads/ and outputs/ are created. Set this to a mounted persistent
# volume (e.g. /var/data) if you want converted files to survive a restart.
# Defaults to the backend/ directory itself.
# DATA_DIR=/var/data
