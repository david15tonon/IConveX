# Port the API server listens on
PORT=3000

# Comma-separated list of origins allowed to call the API (your frontend URL(s)).
# Use "*" only for local development.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Max upload size in megabytes
MAX_UPLOAD_MB=200

# How long (in minutes) a finished job's files are kept before being deleted
JOB_TTL_MINUTES=60

# How many conversions can run at the same time
MAX_CONCURRENT_CONVERSIONS=2
